# Copiá este archivo como `.env` y completá los valores.
# El `.env` está ignorado por git (ver .gitignore).

# URL base del sitio bajo prueba
BASE_URL=https://anibal317.github.io/testing-testingProject

# Rutas públicas (se exponen con Cypress.expose)
HOME_PATH=/index.html
ROOT_PATH=/

# Entorno (qa, staging, prod)
ENVIRONMENT=qa
